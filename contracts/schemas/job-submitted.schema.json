
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskmesh.dev/schemas/job-submitted.schema.json",
  "title": "JobSubmitted",
  "description": "Event emitted when a new job is submitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "job.submitted"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "jobType",
        "payload"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid"
        },
        "jobType": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}